# Committed on purpose.
#
# These two are public by design: Next inlines NEXT_PUBLIC_* into the client
# bundle, so the anon key is already visible to anyone who opens devtools on
# the deployed site. Row Level Security, not secrecy, is what protects the
# data behind it. Committing them means the build works on any host without
# dashboard configuration.
#
# Real environment variables still win — set these in Vercel to point a
# deployment at a different Supabase project and these values are ignored.
#
# SECRETS DO NOT GO IN THIS FILE. SUPABASE_SERVICE_ROLE_KEY and ADMIN_PASSWORD
# belong in .env.local (gitignored) or the host's environment settings.

NEXT_PUBLIC_SUPABASE_URL=https://hpfmnazhwygfsepggvha.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhwZm1uYXpod3lnZnNlcGdndmhhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY5NjEyODEsImV4cCI6MjEwMjUzNzI4MX0.jZXwG-rxZ0bvloaEcmm_m38oEaOF_-cthPAi6MZfmt8
