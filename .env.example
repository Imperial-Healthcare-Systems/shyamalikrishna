# Copy to .env.local and fill in. .env.local is gitignored.

# Sent to the browser — safe to expose, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_.
# The service-role key bypasses RLS entirely; /api/admin is the only consumer.
SUPABASE_SERVICE_ROLE_KEY=
# /api/admin/login returns 503 if this is unset — there is no fallback password.
ADMIN_PASSWORD=
