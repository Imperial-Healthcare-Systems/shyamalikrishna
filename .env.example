# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Sent to the browser — safe to expose, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_.
# The service-role key bypasses RLS entirely. Consumers are /api/admin and
# /api/careers/apply, both of which run server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin portal
# ---------------------------------------------------------------------------

# Bootstrap password for /admin. There is no username — the password alone
# signs the administrator in.
#
# This is used ONLY until the password is changed from Admin → Settings. The
# first successful login writes a scrypt hash into the admin_credentials table
# and from then on this variable is ignored entirely. /api/admin/login returns
# 503 if neither a stored hash nor this variable exists — there is no fallback
# password baked into source control.
#
# LEAVE THIS BLANK HERE. This file is committed to the repository; put the real
# value in .env.local (gitignored) or the host's environment settings.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Email — required for career application alerts and password recovery
#
# Pick ONE of the two blocks below. If neither is set, applications are still
# saved and CVs still stored; they are simply marked "Not configured" in
# Admin → Applications and can be sent later with Resend notification.
# ---------------------------------------------------------------------------

# Option A — SMTP (recommended: use the mailbox you already own)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=info@shyamalikrishna.com
SMTP_PASSWORD=

# Option B — Resend HTTP API (useful when the host blocks outbound SMTP)
# RESEND_API_KEY=

# The From address on outbound mail. Must be an address the transport above is
# allowed to send as. Defaults to SMTP_USER when omitted.
MAIL_FROM=Shyamali Krishna Careers <info@shyamalikrishna.com>

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Used to build absolute links inside emails (the "Open in admin portal" button
# and the password reset link). Falls back to VERCEL_URL, then to the canonical
# production domain.
NEXT_PUBLIC_SITE_URL=https://www.shyamalikrishna.com
