# production
/build
/dist

# environment
# .env.local holds SUPABASE_SERVICE_ROLE_KEY and ADMIN_PASSWORD — never commit.
.env*
# .env holds only NEXT_PUBLIC_* values, which ship in the client bundle anyway,
# and is committed so the build needs no dashboard configuration.
!.env
!.env.example

