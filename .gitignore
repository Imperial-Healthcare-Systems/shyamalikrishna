/.next/
/.next-*/
/out/
next-env.d.ts

# production
/build
/dist

# environment
# No .env file of any kind is committed — not even .env, which holds only
# NEXT_PUBLIC_* values. Every deployment gets its configuration from the host's
# environment settings, so a clone will not build until those are set. Copy
# .env.example to .env.local to work locally.
.env*
!.env.example

# testing
/coverage

# typescript
*.tsbuildinfo

# deployment
.vercel

